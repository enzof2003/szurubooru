# ---- HTTP service ----------------------------------------------------------
API_KEY=change-me-to-a-long-random-string     # clients send it as X-API-Key
HOST=127.0.0.1                                 # keep loopback; put a reverse proxy (TLS) in front on the VPS
PORT=8765
MAX_IMAGE_MB=40
MAX_QUEUE=16             # requests are processed one at a time; this many may wait, the rest get 503
NICE=10                  # Linux: lower CPU priority than szurubooru (inherited by the OCR server)
WARMUP=on                # tiny detection + OCR call at startup; /health says "warming" until done
# Hosts the service may fetch {"image_url": ...} from. Empty = any PUBLIC host
# (private/loopback addresses are refused). On the VPS, if szurubooru serves
# images from localhost, list it here, e.g. ALLOWED_URL_HOSTS=127.0.0.1,booru.example.com
ALLOWED_URL_HOSTS=

# ---- CPU budget (detection + OCR) -----------------------------------------
THREADS=4

# ---- Detection: Koharu Layout RF-DETR Seg 2XL (ONNX) -----------------------
DET_MODEL=models/rfdetr/rfdetr-seg-2xlarge-nomask.onnx
DET_THRESHOLDS=text=0.25,onomatopoeia=0.2,bubble=0.5,panel=0.5
# Classes that are never OCR'd/translated/returned (only counted in meta.skipped).
# Exception: onomatopoeia >= 90% inside a bubble is dialogue and is handled as text.
SKIP_CLASSES=onomatopoeia
SPLIT_BY_COLOR=on        # one note per speaker colour when a block mixes coloured speakers

# ---- OCR: PaddleOCR-VL 1.6 in llama-server ----------------------------------
OCR_SERVER=managed       # managed = the service starts its own llama-server; external = use OCR_BASE_URL
# Windows: tools/llama.cpp-cpu/llama-server.exe   Linux: tools/llama.cpp-cpu/llama-server
# OCR_SERVER_BIN=tools/llama.cpp-cpu/llama-server
OCR_MODEL=models/paddleocr-vl/PaddleOCR-VL-1.6-GGUF.gguf
OCR_MMPROJ=models/paddleocr-vl/PaddleOCR-VL-1.6-GGUF-mmproj.gguf
OCR_PORT=8081
OCR_GPU_LAYERS=0         # 0 = CPU (VPS); 99 = all on GPU (needs a CUDA llama-server build)
OCR_PAD=0.01             # crop margin around each text region, fraction of its longest side
OCR_MAX_PIXELS=0         # 0 = no downscale (llama.cpp already caps image tokens)
OCR_UPSCALE_BELOW=16     # upscale crops whose glyphs are smaller than this (px); 0 = never
OCR_UPSCALE=3            # factor (Lanczos + light blur + unsharp mask), for low-resolution scans
# OCR_SERVER=external
# OCR_BASE_URL=http://127.0.0.1:8081/v1
# OCR_API_KEY=

# ---- LLM (any OpenAI-compatible /v1/chat/completions) -----------------------
# Local llama-server (see start_llm.ps1). LOCAL_LLM_API_KEY is passed to llama-server --api-key.
LOCAL_LLM_API_KEY=change-me
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gemma-4-26b-a4b-it
LLM_API_KEY=change-me
# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-4-26b-a4b-it
# LLM_API_KEY=sk-or-...
VISION=on                # send the page image along with the OCR text
REASONING=off
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=300
LLM_JSON_MODE=on         # response_format=json_object (auto-retries without it on HTTP 400)
VISION_MAX_SIDE=1536     # downscale the page image sent to the LLM
TARGET_LANGUAGE=English
INSTRUCTIONS_FILE=instructions.txt
GLOSSARY_FILE=glossary.txt
# LLM_EXTRA_BODY={"provider": {"sort": "throughput"}}   # merged into every request body
