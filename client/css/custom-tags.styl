/* custom-tags.styl */

/* Make category headings bold and reduce vertical spacing */
.tag-category
  h3.tag-category-heading
    margin: 0.4em 0      /* halves typical spacing; tweak if needed */
    font-weight: 700
    line-height: 1.1
    font-size: 1.05rem

/* Optionally tighten spacing between categories */
.tag-category
  margin: 0.4em 0

.tags h1.tags-heading
  font-weight: 700
  font-size: 2rem




