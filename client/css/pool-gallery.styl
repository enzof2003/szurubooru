.pool-gallery
  padding 20px

  h1
    margin-bottom 24px
    font-size 28px
    font-weight 600
    text-align center

.gallery-grid
  display flex
  flex-direction column
  gap 10px
  margin 0 10px

.gallery-item
  width 100%
  display flex
  justify-content center
  align-items center
  padding 10px 0

.gallery-media
  max-width 100vw
  max-height 100vh
  width auto
  height auto
  object-fit contain
  display block
  margin 0 auto

  opacity 0
  transform translateY(10px)
  animation fadeIn 0.6s ease-out forwards

@keyframes fadeIn
  0%
    opacity 0
    transform translateY(10px)
  100%
    opacity 1
    transform translateY(0)
