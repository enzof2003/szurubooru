.pool-gallery
  padding 20px

  h1
    margin-bottom 24px
    font-size 28px
    font-weight 600
    text-align center

// "Show notes" toggle under the title (only when some post has notes)
.gallery-notes-toggle
  text-align center
  margin -12px 0 16px

.gallery-grid
  display flex
  flex-direction column
  gap 10px
  margin 0 10px

.gallery-item
  width 100%
  display flex
  justify-content center
  align-items center
  padding 10px 0

.gallery-media
  max-width 100vw
  max-height 100vh
  width auto
  height auto
  object-fit contain
  display block
  margin 0 auto

  opacity 0
  transform translateY(10px)
  animation fadeIn 0.6s ease-out forwards

// Image + notes overlay: the box shrinks to the displayed image, the overlay
// covers it exactly, and the note polygons (0-1 viewBox, 100% size) follow it
// on any resize. Fades in together with the image.
.gallery-media-notes
  position relative
  display inline-block
  line-height 0
  cursor pointer

  .post-overlay
    position absolute
    left 0
    top 0
    width 100%
    height 100%
    opacity 0
    animation fadeIn 0.6s ease-out forwards

    .notes-overlay
      position absolute
      left 0
      top 0
      width 100%
      height 100%

@keyframes fadeIn
  0%
    opacity 0
    transform translateY(10px)
  100%
    opacity 1
    transform translateY(0)
